# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional if using built-in project credentials)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Server-Side Abuse Protection & Rate Limiting Configuration
# REQUIRE_AUTH_FOR_AI: Set to "true" to require user authentication on AI endpoints (default "true")
REQUIRE_AUTH_FOR_AI="true"

# Maximum requests per minute per authenticated user for chat/tutoring
RATE_LIMIT_USER_CHAT_MAX="25"

# Maximum document processing uploads per minute per user
RATE_LIMIT_USER_DOC_MAX="10"

# Maximum exam quiz generations per minute per user
RATE_LIMIT_USER_QUIZ_MAX="15"

# Maximum study sheet summaries per minute per user
RATE_LIMIT_USER_SUMMARY_MAX="15"

# Maximum daily AI tutoring queries per user (default 250)
RATE_LIMIT_DAILY_USER_MAX="250"

# Burst defense (max requests in 5-second burst window)
RATE_LIMIT_BURST_MAX="6"
RATE_LIMIT_BURST_WINDOW_MS="5000"

# Fallback network/IP rate limit per minute
RATE_LIMIT_IP_MAX="60"
RATE_LIMIT_WINDOW_MS="60000"
